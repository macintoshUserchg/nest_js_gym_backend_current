{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["<rootDir>/setup-e2e.ts"],
  "modulePathIgnorePatterns": ["<rootDir>/../dist/"],
  "testPathIgnorePatterns": ["<rootDir>/../dist/"],
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "detectOpenHandles": true
}
