DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gym_db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SWAGGER_ENABLED=true
SWAGGER_ALLOWED_IPS=
# S3 storage (Coolify S3 bucket or any S3-compatible endpoint)
# For local dev you can use LocalStack or leave empty to skip storage init
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=gym-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true
MAX_FILE_SIZE=10485760
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FEATURE_ENABLE_REGISTRATION=false
FEATURE_ENABLE_EMAIL_VERIFICATION=false
FEATURE_ENABLE_REFRESH_TOKENS=false
FEATURE_ENABLE_BOOKING_SYSTEM=false
FEATURE_ENABLE_PAYMENT_GATEWAY=false
FEATURE_ENABLE_WEBSOCKET=false
FEATURE_ENABLE_SOFT_DELETE=false
